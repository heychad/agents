{
  "customAgents": {
    "personal-app-builder": {
      "name": "Personal App Builder",
      "description": "Rapidly prototype simple personal utility apps and tools",
      "category": "personal",
      "tools": ["Write", "MultiEdit", "Bash", "Read", "Glob", "Task"],
      "path": "personal/personal-app-builder.md",
      "enabled": true,
      "version": "1.0.0",
      "author": "heychad",
      "tags": ["prototyping", "utilities", "personal", "tools", "automation"],
      "basedOn": "rapid-prototyper"
    },
    "product-manager": {
      "name": "Product Manager",
      "description": "Healthcare tech product management, sprint planning, and backlog prioritization",
      "category": "work",
      "tools": ["Write", "Read", "MultiEdit", "WebSearch", "TodoWrite"],
      "path": "work/product-manager.md",
      "enabled": true,
      "version": "1.0.0",
      "author": "heychad",
      "tags": ["product", "healthcare", "sprint-planning", "backlog", "agile"],
      "domainExpertise": ["HIPAA", "HL7", "FHIR", "Clinical Workflows"]
    }
  },
  "environments": {
    "development": {
      "branch": "development",
      "enabledAgents": ["personal-app-builder", "product-manager"],
      "testMode": true
    },
    "staging": {
      "branch": "staging",
      "enabledAgents": ["personal-app-builder", "product-manager"],
      "testMode": true
    },
    "production": {
      "branch": "main",
      "enabledAgents": ["personal-app-builder", "product-manager"],
      "testMode": false
    }
  },
  "settings": {
    "containsStudioPath": "contains-studio/",
    "customAgentsPath": "./",
    "requireReviewBeforeProduction": true,
    "defaultEnvironment": "development"
  }
}